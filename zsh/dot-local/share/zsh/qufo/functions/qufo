#!/usr/bin/env zsh

usage() { bat -pl help <<EOF
Usage: $0 [-m <mode>]
  -m <mode>  Set mode directory
  -h         Show this help

Modes:
  browse (default)  Start fzf to browse files
  preview <file>    Preview <file>
  open <file>       Open <file>

  Browse:
    Browse files in \$HOME ($HOME). Builds

    Options:
      -x <cmd>      Execute <cmd> on selected file
      -p            Paste selected file to prompt

    Keybindings:
      ctrl-m        Open file in nvim
      ctrl-o        Open file in default application
      ctrl-t        Open file in new kitty tab
			ctrl-d				CD into the file's directory

  Open:
    Opens the file in \$EDITOR ($EDITOR), unless -o is given

    Options:
      -o            Open file in default application for the file type.
      -t            Open file in new kitty tab
EOF
}

ROOT_DIR="$HOME"
FILE_INDEX="$HOME/file_index"

zparseopts -D -E -F -A opts m:: h x:: e p

if [[ -n ${opts[(i)-h]} ]]; then
  usage
	return 0
fi

mode=${opts[-m]:-browse}
if [[ $mode = "preview" ]]; then

  if [[ -z $1 ]]; then
    echo "No file given"
    return 1
  fi

  # Resolve relative paths (index entries are relative to $ROOT_DIR)
  if [[ "$1" = /* ]]; then
    target="$1"
  else
    target="$ROOT_DIR/$1"
  fi

  file_type=$(command file -b --mime-type "$target" 2>/dev/null)
  extension="${target:l:e}"

  # Fall back to extension when `file` is unavailable / inconclusive
  if [[ -z $file_type || $file_type == "application/octet-stream" ]]; then
    case "$extension" in
      png|jpg|jpeg|gif|webp|bmp|svg|avif) file_type="image/$extension" ;;
      mp4|mkv|webm|mov|avi|m4v)           file_type="video/$extension" ;;
    esac
  fi

  echo "\x1b[32m$file_type\x1b[0m"

  # icat opts so it renders inside the fzf preview pane
  icat=(kitten icat --clear --transfer-mode=memory --stdin=yes --place=${FZF_PREVIEW_COLUMNS:-80}x${FZF_PREVIEW_LINES:-24}@0x1)

  show-meta() {
    echo
    echo "\x1b[1mFile:\x1b[0m     $target"
    stat -c $'\e[1mSize:\e[0m     %s bytes (%n)\n\e[1mModified:\e[0m %y\n\e[1mPerms:\e[0m    %A  \e[1mOwner:\e[0m %U:%G' "$target" 2>/dev/null
  }

  case "$file_type" in
    image/*)
      $icat < "$target" || show-meta
      ;;
    video/*)
      # grab the first frame and pipe to icat
      ffmpeg -loglevel error -i "$target" -frames:v 1 -f image2 -vcodec png - 2>/dev/null | $icat || show-meta
      ;;
    *)
      case "$extension" in
        json)
          jq -C . "$target" 2>/dev/null || cat "$target"
          ;;
        *)
          # `grep -I` treats binary files as non-matching; use it to gate `cat`
          if grep -Iq . "$target" 2>/dev/null; then
            cat "$target"
          else
            show-meta
          fi
          ;;
      esac
      ;;
  esac

  return 0
fi

find-project-root () {
  local dir="$1"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.git" 
          || -f "$dir/.git" 
          || -f "$dir/package.json" 
          || -f "$dir/Cargo.toml"
          || -f "$dir/Cargo.lock"
          || -f "$dir/Makefile"
      ]]; then
      echo "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

if [[ $mode = "browse" ]]; then
  if [[ ! -f $FILE_INDEX ]]; then
    echo "File index not found. Running $0 -m build-index"
    $0 -m build-index
  fi

  BINDINGS=(
    "ctrl-o:execute-silent(xdg-open $ROOT_DIR/{} >/dev/null 2>&1 &)"
    "ctrl-t:execute-silent(kitten @ launch --type=tab --cwd=$ROOT_DIR --tab-title {} \$EDITOR $ROOT_DIR/{})"
    "ctrl-d:become(cd \"\$(dirname $ROOT_DIR/{})\" && exec \$SHELL)"
  )

  if [[ -n ${opts[(i)-p]} ]]; then
    BINDINGS+=("ctrl-y:put(echo $ROOT_DIR/{})")
  fi

  EXECUTE_CMD=${opts[-x]}
  if [[ -n $EXECUTE_CMD ]]; then
    BINDINGS+=("enter:execute(echo $ROOT_DIR/{} | $EXECUTE_CMD)")
  elif [[ -z ${opts[(i)-p]} ]]; then
    BINDINGS+=("enter:become(\$EDITOR $ROOT_DIR/{})")
  fi

  cat ~/file_index |                           \
    fzf                                        \
    --ansi                                     \
    --history=$HOME/.file_index_history        \
    --preview "$0 -m preview {}"               \
		--header "ctrl-d: cd | ctrl-o: open  | ctrl-t: open in kitty | ctrl-y: put | return: edit" \
    --keep-right                               \
    --bind ${(j:,:)BINDINGS}
fi

if [[ $mode = "build-index" ]]; then
  fd                   \
    -tf                \
    -E cache           \
    -E Caches          \
    -E Library         \
    -E .git            \
    -E node_modules    \
    '' $HOME           \
    | sed "s#^$HOME/##" \
    > "$FILE_INDEX"
fi
