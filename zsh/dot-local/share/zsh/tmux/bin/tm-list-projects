#!/usr/bin/env zsh

if [[ -z $TM_PROJECTS ]]; then
  echo "TM_PROJECTS is not set" >&2
  exit 1
fi

for dir in "${(@s.:.)TM_PROJECTS}"; do
  dir="${dir#"${dir%%[![:space:]]*}"}"  # Trim leading whitespace
  dir="${dir%"${dir##*[![:space:]]}"}"  # Trim trailing whitespace
  dir="${dir/#\~/$HOME}"

  if [[ "$dir" == *\* ]]; then
    fd --type d --max-depth 1 . "${dir%\*}"
  else
    echo "${dir}"
  fi
done
