#!/usr/bin/env zsh

folder=$( echo $1 | sed "s#~#$HOME#")
cd $folder

if [[ -f "package.json" ]]; then
	cat "package.json" | jq -r '[.name, .description] | .[] | select(. != null)'
fi

if [[ -f ".git" ]]; then
    if [[ $(git rev-parse --is-inside-work-tree) ]]; then
	    echo "--- git:"
	    git log --oneline . | head -n 4
    fi
fi

if [[ -f "$1/README.md" ]]; then
	echo "--- README.md"
	echo
	cat "$1/README.md"
fi
